\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Burgers wave propagation, classical (dashed) vs.\ ideal quantum (solid, matches to $\sim 10^{-6}$) vs.\ noisy hardware readout (dotted). Viscosity here is ten times smaller than in Fig.~\ref {fig:carleman-burgers}, so advective steepening is far more visible before diffusion catches up, while the maximum principle of Sec.~\ref {sec:intro} still caps $\lVert u(t) \rVert _\infty $; the ideal curve tests physical fidelity, the noisy curve tests hardware degradation.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:burgers-var}{{5}{9}{Burgers wave propagation, classical (dashed) vs.\ ideal quantum (solid, matches to $\sim 10^{-6}$) vs.\ noisy hardware readout (dotted). Viscosity here is ten times smaller than in Fig.~\ref {fig:carleman-burgers}, so advective steepening is far more visible before diffusion catches up, while the maximum principle of Sec.~\ref {sec:intro} still caps $\norm {u(t)}_\infty $; the ideal curve tests physical fidelity, the noisy curve tests hardware degradation}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces KdV wave propagation with the implicit-midpoint target of Sec.~\ref {sec:implicit-midpoint}; $\lVert u \rVert _2$ is conserved to $10^{-10}$ classically and matched to $\sim 10^{-7}$ by the quantum fit. Dispersion ($\delta \partial _{xxx}u$) replaces Burgers' diffusion: instead of damping gradients, it spreads different wavelengths at different phase velocities, turning would-be steepening into an oscillatory wave train rather than a shock -- a conservative, not dissipative, mechanism, which is exactly why $\lVert u \rVert _2$ stays constant here (Sec.~\ref {sec:closure}) where it strictly decreases for Burgers.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:kdv-var}{{6}{9}{KdV wave propagation with the implicit-midpoint target of Sec.~\ref {sec:implicit-midpoint}; $\norm {u}_2$ is conserved to $10^{-10}$ classically and matched to $\sim 10^{-7}$ by the quantum fit. Dispersion ($\delta \partial _{xxx}u$) replaces Burgers' diffusion: instead of damping gradients, it spreads different wavelengths at different phase velocities, turning would-be steepening into an oscillatory wave train rather than a shock -- a conservative, not dissipative, mechanism, which is exactly why $\norm {u}_2$ stays constant here (Sec.~\ref {sec:closure}) where it strictly decreases for Burgers}{figure.6}{}}
