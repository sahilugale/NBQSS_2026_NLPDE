\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces General circuit primitives: (a) one repetition of the $R_y$/CNOT ansatz layer, applied $n$ times in total; (b) the ancilla-free cyclic shift gate $S$ ($n=3$; the staircase of $(n{-}1{-}k)$-controlled $X$'s targeting qubit $k$, $k=n{-}1,\dots  ,1$, then $X$ on qubit $0$, extends to any $n$); (c) the single-ancilla metric off-diagonal circuit, generator insertions $Y_k,Y_l$ between sub-unitaries $U_{\rm  bef},U_{\rm  mid},U_{\rm  aft}$ of the ansatz; (d) the two-register nonlinear cross-term circuit, $n$-qubit registers $A,B$, no controlled-ansatz gates anywhere.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:circuits}{{4}{7}{General circuit primitives: (a) one repetition of the $R_y$/CNOT ansatz layer, applied $n$ times in total; (b) the ancilla-free cyclic shift gate $S$ ($n=3$; the staircase of $(n{-}1{-}k)$-controlled $X$'s targeting qubit $k$, $k=n{-}1,\dots ,1$, then $X$ on qubit $0$, extends to any $n$); (c) the single-ancilla metric off-diagonal circuit, generator insertions $Y_k,Y_l$ between sub-unitaries $U_{\rm bef},U_{\rm mid},U_{\rm aft}$ of the ansatz; (d) the two-register nonlinear cross-term circuit, $n$-qubit registers $A,B$, no controlled-ansatz gates anywhere}{figure.4}{}}
